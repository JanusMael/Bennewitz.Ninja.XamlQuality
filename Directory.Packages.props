<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Versioning">
    <PackageVersion Include="Bennewitz.Ninja.AutoVersioning" Version="2026.3.916" />
  </ItemGroup>

  <ItemGroup Label="Tool">
    <!-- The CLI face only. ⛔ The rules LIBRARY takes no package reference at all, and that is a
         contract rather than an accident: a quality analyser that drags dependencies into a
         consumer's test project is one people stop referencing. -->
    <PackageVersion Include="System.CommandLine" Version="2.0.0-beta7.25380.108" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- ⚠ xunit.v3 rather than MSTest, and that is a porting decision rather than a preference.
         The ThemeAudit rules and their fourteen test files came from a repository that uses
         xunit; matching it let those tests move VERBATIM. Converting them instead would have
         meant rewriting the one thing that proves the ported analysis still behaves — which is
         the worst possible file to rewrite during a move.
         ⓘ The rules library itself references no test framework at all, so this choice binds
         nobody: a consumer asserts on findings with whatever runner they already use. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <!-- Same Microsoft.Testing.Platform line as xunit.v3 3.2.2 (1.9.1); a newer TrxReport pins
         the platform above what xunit's bundled MSBuild extension can load. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="1.9.1" />
    <!-- The family's assembly rules, run over both assemblies this repository ships. Test-only,
         like everything in this group: the rules library still takes no package reference. -->
    <PackageVersion Include="Bennewitz.Ninja.AssemblyQuality" Version="2026.3.922" />
  </ItemGroup>
</Project>
