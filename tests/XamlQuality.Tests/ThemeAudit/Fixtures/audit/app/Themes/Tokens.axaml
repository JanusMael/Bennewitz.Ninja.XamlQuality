<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Dark's AppOwn is deliberately too faint on the host page. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="AppOwn" Color="#1C1F23" />
      <SolidColorBrush x:Key="AppMarker" Color="#2E7D32" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AppOwn" Color="#3A3A3A" />
      <SolidColorBrush x:Key="AppMarker" Color="#81C784" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
